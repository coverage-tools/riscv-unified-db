{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://[^ ]+$"
      }
    },
    "facts": {
      "type": "object",
      "properties": {
        "operands": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "enum": ["gpr", "fpr", "vr", "modifier", "immediate"]
              },
              "role": {
                "enum": [
                  "read",
                  "write",
                  "read_write",
                  "unused",
                  "not_applicable"
                ]
              }
            },
            "anyOf": [
              {
                "required": ["kind"]
              },
              {
                "required": ["role"]
              }
            ]
          }
        },
        "memory_access": {
          "enum": [
            "none",
            "load",
            "store",
            "atomic",
            "prefetch",
            "cache_management",
            "environment_defined",
            "csr_dependent"
          ]
        },
        "control_flow": {
          "enum": [
            "none",
            "branch",
            "jump",
            "indirect_jump",
            "trap_return",
            "environment_call",
            "csr_dependent"
          ]
        }
      },
      "anyOf": [
        {
          "required": ["operands"]
        },
        {
          "required": ["memory_access"]
        },
        {
          "required": ["control_flow"]
        }
      ]
    },
    "nativeFacts": {
      "allOf": [
        {
          "$ref": "#/$defs/facts"
        }
      ],
      "type": "object",
      "required": ["version", "references"],
      "properties": {
        "version": {
          "const": 1
        },
        "references": {
          "$ref": "#/$defs/references"
        }
      },
      "unevaluatedProperties": false
    },
    "nativePatch": {
      "type": "object",
      "required": ["custom_semantics"],
      "properties": {
        "custom_semantics": {
          "$ref": "#/$defs/nativeFacts"
        }
      },
      "additionalProperties": false
    }
  },
  "$ref": "#/$defs/nativePatch"
}
